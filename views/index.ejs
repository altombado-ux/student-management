<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/">Student Management System</a>
    <div class="nav-links">
      <a href="/">Students</a>
      <a href="/students/add">Add Student</a>
    </div>
  </nav>

  <main class="container">
    <div class="toolbar">
      <form action="/students/search" method="GET" class="search-form">
        <input type="text" name="keyword" placeholder="Search student...">
        <button type="submit" class="btn">Search</button>
      </form>
      <a class="btn btn-primary" href="/students/add">+ Add Student</a>
    </div>

    <h2>Student List</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Student ID</th>
            <th>Name</th>
            <th>Course</th>
            <th>Year</th>
            <th>Email</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(student => { %>
          <tr>
            <td><%= student.id %></td>
            <td><%= student.student_id %></td>
            <td><%= student.first_name %> <%= student.last_name %></td>
            <td><%= student.course %></td>
            <td><%= student.year_level %></td>
            <td><%= student.email %></td>
            <td>
  <form action="/students/delete/<%= student.id %>" method="POST"
        onsubmit="return confirm('Delete this student?');">
    <button type="submit" class="btn btn-danger">Delete</button>
  </form>
</td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>